exports[`explanation text for every example > upsert in mysql: advanced 1`] = `
"Adds 1 row to customers, filling email, name and updated_at; when a row clashes with an existing unique key, that row's name and updated_at are updated instead.
VALUES: The rows you typed, one new row each.
  + Columns that aren't listed get their default value, or NULL.
INSERT INTO: Adds the rows to the table.
  + If any row breaks a constraint (a unique key, NOT NULL or a foreign key), the statement fails and no rows are added.
ON DUPLICATE KEY: When a row clashes with an existing unique key, this decides what happens instead of an error.
  + ON DUPLICATE KEY UPDATE reacts to any unique key, including the primary key. VALUES(column) is the value that was about to be inserted."
`;

exports[`explanation text for every example > upsert in mysql: beginner 1`] = `
"Adds 1 row to customers, filling email, name and updated_at; when a row clashes with an existing unique key, that row's name and updated_at are updated instead.
VALUES: The rows you typed, one new row each.
INSERT INTO: Adds the rows to the table.
ON DUPLICATE KEY: When a row clashes with an existing unique key, this decides what happens instead of an error."
`;

exports[`explanation text for every example > upsert in mysql: developer 1`] = `
