{
  "name": "sql-query-builder-pro-lite",
  "version": "1.0.0",
  "description": "Lightweight SQL query builder - runs entirely in browser",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "serve .",
    "start": "serve .",
    "deploy": "npx vercel --prod",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm test",
    "typecheck": "tsc -p jsconfig.json"
  },
  "keywords": [
    "sql",
    "query-builder",
    "database",
    "vanilla-js",
    "no-framework"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "serve": "^14.2.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
